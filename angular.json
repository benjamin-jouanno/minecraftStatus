{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "minecraft-status-dashboard": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": ["src/styles.css"]
          },
          "configurations": { "production": { "budgets": [{ "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" }], "outputHashing": "all" } },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular-devkit/build-angular:dev-server", "configurations": { "production": { "buildTarget": "minecraft-status-dashboard:build:production" }, "development": { "buildTarget": "minecraft-status-dashboard:build" } }, "defaultConfiguration": "development" }
      }
    }
  }
}
